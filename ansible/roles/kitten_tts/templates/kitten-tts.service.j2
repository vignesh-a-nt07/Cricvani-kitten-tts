[Unit]
Description=CricVani Kitten TTS Server
After=network.target

[Service]
User={{ app_user }}
Group={{ app_group }}
WorkingDirectory={{ app_dir }}
ExecStart={{ venv_dir }}/bin/python -m uvicorn app:app --host 0.0.0.0 --port {{ app_port }}
Restart=on-failure
RestartSec=5s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ app_name }}

[Install]
WantedBy=multi-user.target
